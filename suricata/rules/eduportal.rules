# EduPortal - Custom Suricata rules
#
# SID range 1000000-1099999 is reserved by Suricata convention for local rules.
#
# Suricata runs in nginx's network namespace, so HTTP rules trigger on
# upstream traffic to web-app:3000 and api-server:4000 after TLS terminates
# at nginx. 
# Alerts go to /var/log/suricata/eve.json and /var/log/suricata/fast.log

# IDS-EP-1000001
# Detects the UNION-based extraction payload against the course search endpoint. 
# CRS would also catch this at the WAF tier
alert http any any -> any any ( \
    msg:"IDS-EP-1000001 SQLi UNION SELECT against /api/courses/search"; \
    flow:established,to_server; \
    http.uri; content:"/api/courses/search"; \
    http.uri; pcre:"/UNION\s+(ALL\s+)?SELECT/i"; \
    classtype:web-application-attack; \
    metadata:vuln V1, owasp A03; \
    sid:1000001; rev:1; \
)

# IDS-EP-1000002
# Fires when one source IP submits more than 10 POSTs to /api/auth/login in 60 seconds
# enables once MD5 hashes are cracked offline, and 
# the Hydra/Burp-Intruder style probe attackers run before they bother forging JWTs.
alert http any any -> any any ( \
    msg:"IDS-EP-1000002 brute-force burst on /api/auth/login"; \
    flow:established,to_server; \
    http.method; content:"POST"; \
    http.uri; content:"/api/auth/login"; \
    detection_filter:track by_src, count 10, seconds 60; \
    classtype:attempted-user; \
    metadata:vuln V4_V7, owasp A07; \
    sid:1000002; rev:1; \
)

# IDS-EP-1000003
# Fires when one source IP hits any /api/admin/* or /rest/admin/* path more than 15 times in 30 seconds. 
alert http any any -> any any ( \
    msg:"IDS-EP-1000003 admin endpoint enumeration burst"; \
    flow:established,to_server; \
    http.uri; pcre:"/^\/(api|rest)\/admin\//"; \
    detection_filter:track by_src, count 15, seconds 30; \
    classtype:web-application-attack; \
    metadata:vuln V6, owasp A01; \
    sid:1000003; rev:1; \
)



