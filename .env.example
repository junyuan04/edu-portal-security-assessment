
# SETUP: Copy this file and rename it to .env
#        Then fill in the values below.

# General
NODE_ENV=development

# Database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=myeduconnect
DB_USER=myeduconnect_user
DB_PASSWORD=your_db_password_here
DB_ROOT_PASSWORD=your_root_password_here

# Web app
WEB_APP_PORT=3000
JWT_SECRET=secret123
JWT_EXPIRES_IN=0

# API server
API_SERVER_PORT=4000
API_JWT_SECRET=secret123

# Admin (weak by design)
ADMIN_DEFAULT_EMAIL=admin@myeduconnect.my
ADMIN_DEFAULT_PASSWORD=admin123

# Nginx
NGINX_HTTP_PORT=80

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:80/api
VITE_WEB_APP_URL=http://localhost:80

# API client (Vite)
VITE_REST_API_BASE_URL=http://localhost:80/rest

# SSH (weak by design)
SSH_PORT=2222
SSH_ROOT_PASSWORD=admin123